# --- LLM Providers ---
# Provide at least one API key. Users can also enter their own key in the UI.
GOOGLE_API_KEY=your_default_google_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default (cheap) models used when running in online mode with the system key
GEMINI_MODEL=gemini-2.0-flash-lite

# --- Local models (optional) ---
# Base URL of a running Ollama server. No API key required.
OLLAMA_BASE_URL=http://localhost:11434

# --- Application ---
# "true" for the hosted demo (pre-configured system key), "false" for local use
ONLINE_MODE=false

# Directory used for local persistence (analysis history)
DATA_DIR=data
